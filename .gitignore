# data is regenerable from the pipeline — never commit it
data/raw/*
data/intermediate/*
data/derived/*
!data/**/.gitkeep

# credentials — NEVER commit your Google Cloud key
gcp-key.json
*-credentials.json
service-account*.json
.env

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# latex build artifacts
thesis/*.aux
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.synctex.gz
